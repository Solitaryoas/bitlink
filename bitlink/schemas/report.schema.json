{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "BitLink execution report",
  "type": "object",
  "properties": {
    "status": {
      "type": "string",
      "enum": ["completed", "failed", "blocked"]
    },
    "summary": {
      "type": "string"
    },
    "evidence": {
      "type": "array",
      "items": { "type": "string" }
    },
    "files_changed": {
      "type": "array",
      "items": { "type": "string" }
    },
    "blockers": {
      "type": "array",
      "items": { "type": "string" }
    }
  },
  "required": ["status", "summary", "evidence", "files_changed", "blockers"],
  "additionalProperties": false
}
